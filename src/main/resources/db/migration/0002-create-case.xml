<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- US-1: Fall erfassen — Case-Aggregat mit Audit-Trail und Fallnummern-Sequence. -->
    <changeSet id="0002-create-case-sequence" author="caseflow">
        <createSequence sequenceName="case_number_seq" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="0002-create-case-table" author="caseflow">
        <createTable tableName="cases">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_number" type="VARCHAR(30)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="case_reference" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="case_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="priority" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="source" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0002-create-case-audit-entry-table" author="caseflow">
        <createTable tableName="case_audit_entry">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="actor" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="occurred_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="case_audit_entry"
            baseColumnNames="case_id"
            constraintName="fk_case_audit_entry_case"
            referencedTableName="cases"
            referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
